><global_filter/></table><table schema="main" name="work_roles" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="111"/><column index="3" value="175"/><column index="4" value="40"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">PRAGMA foreign_keys = OFF;

ALTER TABLE project_teamleads RENAME TO project_teamleads_old;

CREATE TABLE project_teamleads (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    project_id INTEGER NOT NULL,
    user_id INTEGER NOT NULL,
    assigned_at DATETIME NULL,
    CONSTRAINT uq_project_teamlead UNIQUE (project_id, user_id),
    FOREIGN KEY (project_id) REFERENCES projects(id),
    FOREIGN KEY (user_id) REFERENCES users(id)
);

INSERT INTO project_teamleads (id, project_id, user_id, assigned_at)
SELECT id, project_id, user_id, assigned_at
FROM project_teamleads_old;

DROP TABLE project_teamleads_old;

PRAGMA foreign_keys = ON;</sql><current_tab id="0"/></tab_sql></sqlb_project>
